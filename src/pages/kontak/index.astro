---
import Page from '../../components/Page.astro';
import { site, waLink } from '../../lib/site';
import content from '../../data/content.json';
const maps = site.mapsUrl;
const steps = [
  ['Isi formulir dan hubungi tim MEC', 'Isi formulir pendaftaran, lalu tanyakan jadwal, biaya, persyaratan, dan alur seleksi lewat WhatsApp atau email.'],
  ['Ikuti seleksi', content.stages[0].items.join(' · ') + '.'],
  ['Mulai belajar', 'In-class training, lalu On the Job Training untuk praktik di lapangan.'],
];
---
<Page title="Kontak & Konsultasi" image="building" imageAlt="Gedung MEC Academy" eyebrow="Langkah berikutnya" description="Hubungi tim MEC (Senin–Jumat 08.00–16.00) atau isi formulir pendaftaran Basic Mechanic Course untuk jadwal, biaya, dan persyaratan.">
  <div class="contact-cards">
    <a href={waLink()} target="_blank" rel="noopener"><small>WhatsApp</small><b>{site.phone}</b><span>Chat untuk jadwal & pendaftaran ↗</span></a>
    <a href={`tel:${site.phone.replace(/\s/g, '')}`}><small>Telepon</small><b>{site.phone}</b><span>Hubungi langsung ↗</span></a>
    <a href={`mailto:${site.email}`}><small>Email</small><b>{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</b><span>Kirim pertanyaan ↗</span></a>
    <a href={site.registerFormUrl} target="_blank" rel="noopener"><small>Pendaftaran</small><b>Formulir BMC</b><span>Isi formulir angkatan berjalan ↗</span></a>
    <a href={maps} target="_blank" rel="noopener"><small>Alamat</small><b>Plaosan, Wonosari, Malang</b><span>{site.address} Buka peta ↗</span></a>
  </div>
  <p class="mt-8 text-sm text-sage">Jam operasional: {site.hoursLabel}. Ikuti kami: <a class="text-gold underline" href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a> · <a class="text-gold underline" href={site.youtubeUrl} target="_blank" rel="noopener">YouTube</a> · <a class="text-gold underline" href={site.facebookUrl} target="_blank" rel="noopener">Facebook</a> · <a class="text-gold underline" href={site.linkedinUrl} target="_blank" rel="noopener">LinkedIn</a> · <a class="text-gold underline" href={site.googleProfileUrl} target="_blank" rel="noopener">Google</a> · TikTok (segera hadir).</p>
  <h2 class="mb-6 mt-16 text-4xl">Cara mendaftar</h2>
  <ol class="grid gap-6 md:grid-cols-3">
    {steps.map(([t, d], i) => <li class="border-t-2 border-gold pt-4"><span class="font-mono text-xs text-gold">0{i + 1}</span><h3 class="mt-2 text-2xl">{t}</h3><p class="mt-2 text-sm text-sage">{d}</p></li>)}
  </ol>
  <p class="mt-10 max-w-2xl text-sm text-sage">Ada pertanyaan umum? Lihat <a class="text-gold underline" href="/faq/">FAQ</a> atau <a class="text-gold underline" href="/tahapan-seleksi/">tahapan seleksi & pelatihan</a>.</p>
</Page>
