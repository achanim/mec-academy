---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img, pos } from '../lib/images';
import { modules, waLink, site, slugify } from '../lib/site';
import ChapterUI from '../components/ChapterUI.astro';
import { publishedArticles, categories } from '../lib/articles';
import { systems } from '../data/systems';
import { faq } from '../data/faq';
import content from '../data/content.json';
import research from '../data/research.json';
const h = research.hero;
const latest = (await publishedArticles()).slice(0, 3);
const journey = [
  ['01', 'Kenali dasarnya.', 'Assessment & in-class training', 'classroom'],
  ['02', 'Praktikkan ilmunya.', 'Komponen, unit & evaluasi', 'practice'],
  ['03', 'Kembangkan dirimu.', 'On the Job Training', 'ojt'],
] as const;
const learning = [
  ['Classroom', 'classroom', 'Belajar konsep dan prosedur bersama instruktur.'],
  ['Component training', 'gallery-02', 'Mengenal komponen alat berat secara langsung.'],
  ['Workshop practice', 'workshop', 'Praktik di workshop dengan tools & equipment.'],
  ['Observasi & evaluasi', 'gallery-01', 'Mengamati, mencatat, dan mengevaluasi hasil praktik.'],
] as const;
const events = ['event-komatsu', 'event-sinarindo', 'event-ppa'].map((a) => content.events.find((e) => e.asset === a)!);
const chapters = [
  { id: 'hero', title: 'Mulai langkahmu' }, { id: 'challenge', title: 'Kebutuhan industri' }, { id: 'bmc', title: 'Perjalanan BMC' },
  { id: 'machine', title: 'Jelajahi sistem' }, { id: 'learning', title: 'Belajar melalui praktik' }, { id: 'character', title: 'Mekanik berkarakter' },
  { id: 'instructors', title: 'Belajar bersama instruktur' }, { id: 'about', title: 'Tentang MEC' }, { id: 'industry', title: 'Terhubung dengan industri' },
  { id: 'alumni', title: 'Alumni dan OJT' }, { id: 'film', title: 'Company profile' }, { id: 'contact', title: 'Mulai BMC' },
];
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'id' };
---
<Base home footer={false} title="MEC Academy — Kursus Mekanik Alat Berat di Malang" description="Mulai langkahmu menjadi mekanik alat berat. Basic Mechanic Course MEC Academy: 16 modul, praktik komponen, instruktur industri, dan pembentukan karakter." jsonLd={ld}>
  <ChapterUI chapters={chapters} />

  <!-- 01 Hero -->
  <section class="chapter" id="hero" data-ch="Mulai langkahmu" data-chapter="hero" data-span="1.9">
    <div class="scene isolate">
      <div class="depth-photo"><Image src={img('hero')} alt="Siswa MEC Academy praktik di workshop" class="h-full w-full object-cover" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
      <div class="absolute inset-0 z-[-1] bg-gradient-to-r from-ink via-ink/75 to-ink/5"></div>
      <div class="technical-grid" aria-hidden="true"></div>
      <span class="hero-word" aria-hidden="true">PRAKTIK.</span>
      <figure class="hero-frame" aria-hidden="true">
        <div class="hero-frame-image"><Image src={img('practice')} alt="" widths={[480, 720, 1600]} sizes="31vw" loading="eager" class="h-full w-full object-cover" /></div>
        <figcaption><span>01 / PRAKTIK KOMPONEN</span><strong>Kenali. Coba. Pahami.</strong></figcaption>
      </figure>
      <div class="scene-pad wrap"><div class="scene-inner hero-copy">
        <p class="eyebrow mb-6">01 / Basic Mechanic Course</p>
        <h1 class="display max-w-4xl" data-split>Mulai langkahmu.<br />Jadi mekanik<br /><em>alat berat.</em></h1>
        <p class="hero-hook">{h.lead}</p>
        <p class="body-copy" style="font-size:16px;line-height:1.5;max-width:470px;margin-bottom:24px">Bangun dasar teknis, pengalaman praktik, dan karakter profesional melalui BMC MEC Academy.</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a class="btn" href={waLink()} target="_blank" rel="noopener">{h.primary_cta} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#challenge">{h.secondary_cta} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="micro-proof"><span>{modules.length} modul pembelajaran</span><i></i><span>Praktik komponen</span><i></i><span>Pembentukan karakter</span></p>
      </div></div>
      <p class="floating-caption" aria-hidden="true"><span class="plus">+</span><span>LEARN BY DOING<br /><b>Mulai dari praktik nyata.</b></span></p>
      <div class="scene-bottom"><p class="scroll-cue" aria-hidden="true">Gulir untuk menjelajah <span>↓</span></p>
      <a class="film-link" href="#film"><span aria-hidden="true">▷</span> Tonton company profile</a></div>
    </div>
  </section>

  <!-- 02 Challenge -->
  <section class="chapter on-paper" id="challenge" data-ch="Kebutuhan industri" data-chapter="challenge" data-span="1.3">
    <div class="scene bg-paper text-green">
      <div class="scene-pad wrap"><div class="scene-inner">
        <div class="split">
          <div><p class="eyebrow mb-4">02 / Tantangan di balik setiap unit</p>
          <h2 class="display" data-split>Alat harus siap.<br /><em>Mekaniknya juga.</em></h2></div>
          <div class="split-copy" data-reveal>
            <p class="lead">Kesiapan alat bertumpu pada perawatan yang tepat. Kesiapan mekanik dibangun melalui kompetensi, keselamatan, dan disiplin kerja.</p>
            <p>Bekali dirimu untuk memahami sistem, mengikuti prosedur, dan bekerja bersama tim.</p>
            <a class="dark-link" href="/sumber/">Baca konteks industri & sumber <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <ul class="points">
          {[['01 / Kompetensi', 'Pahami sistemnya.', 'Bangun dasar untuk mengenali komponen dan proses perawatan.'], ['02 / Keselamatan', 'Biasakan cara aman.', 'APD, prosedur, dan kepedulian pada rekan kerja.'], ['03 / Kesiapan kerja', 'Latih sikapnya.', 'Disiplin, komunikasi, dan tanggung jawab dalam praktik.']].map(([k, t, d], i) => (
            <li data-step style={`--i:${i};--step:var(--s${i})`}><span class="font-mono text-xs">{k}</span><h3 class="mt-2 text-3xl">{t}</h3><p class="mt-2 text-sm">{d}</p></li>
          ))}
        </ul>
        <div class="policy-note"><span class="font-mono text-xs">ARAH VOKASI 2026</span>
          <p>Pemerintah mendorong kesesuaian kompetensi lulusan dengan kebutuhan industri. Jadikan pembelajaran yang relevan sebagai langkah persiapanmu.</p>
          <a class="underline" href="https://www.kemenkopmk.go.id/atasi-pengangguran-terdidik-kemenko-pmk-dorong-pendekatan-co-creation-antara-kampus-dan-industri" rel="noopener" target="_blank">Kemenko PMK · 9 Sep 2026 ↗</a></div>
      </div></div>
      <div class="scene-gate" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 03 BMC -->
  <section class="chapter" id="bmc" data-ch="Perjalanan BMC" data-chapter="journey" data-span="1.35">
    <div class="scene bg-green-grad">
      <div class="scene-pad wrap"><div class="scene-inner">
        <div class="split">
          <div><p class="eyebrow mb-4">03 / Perjalananmu di MEC</p><h2 class="display" data-split>Dari belajar.<br /><em>Menuju industri.</em></h2></div>
          <p class="split-copy text-sage" data-reveal>Basic Mechanic Course menyatukan dasar teknik, praktik komponen, dan pembentukan karakter dalam proses yang terarah.</p>
        </div>
        <ol class="journey">
          <span class="journey-line" aria-hidden="true"></span>
          {journey.map(([n, t, d, i], k) => (
            <li data-step style={`--i:${k};--step:var(--s${k})`}><div class="journey-image"><Image src={img(i)} alt="" widths={[480, 720, 960]} sizes="(min-width:768px) 33vw, 76vw" loading="lazy" class="journey-img" style={pos(i)} /><span class="step-no">{n}</span></div>
              <h3>{t}</h3><p class="text-sage">{d}</p></li>
          ))}
        </ol>
        <div class="flex flex-wrap gap-4"><a class="btn" href="/tahapan-seleksi/">Lihat tahapan BMC <span aria-hidden="true">↗</span></a><a class="text-link" href={waLink('Halo MEC Academy, saya ingin bertanya jadwal dan persyaratan BMC.')} target="_blank" rel="noopener">Tanya jadwal & persyaratan <span aria-hidden="true">↗</span></a></div>
      </div></div>
      <div class="scene-gate" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 04 Machine -->
  <section class="chapter" id="machine" data-ch="Jelajahi sistem" data-chapter="machine" data-span="1.9">
    <div class="scene bg-machine">
      <div class="scene-pad wrap"><div class="scene-inner">
        <div class="machine-layout">
          <div>
            <p class="eyebrow mb-4">04 / Explore the machine</p><h2 class="display" data-split>Kenali mesin.<br /><em>Bangun skill.</em></h2>
            <p class="mt-6 max-w-sm text-sage" data-reveal>Pilih sistem yang ingin kamu pelajari, lalu jelajahi contoh materi BMC.</p>
            <div role="tablist" aria-label="Sistem mesin" class="system-tabs">
              {systems.map((s, i) => <button role="tab" data-tab id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>{s.code}</button>)}
            </div>
            <a class="text-link" href="/program/basic-mechanic-course/modul/">Lihat seluruh {modules.length} modul <span aria-hidden="true">↗</span></a>
          </div>
          <div class="machine-stage" data-stage>
            {systems.map((s, i) => (
              <div role="tabpanel" data-panel id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0} class="spatial-frame">
                <div class="spatial-back" aria-hidden="true"></div>
                <div class="spatial-guide" aria-hidden="true"></div>
                <Image src={img(s.image)} alt={s.alt} widths={[640, 960]} sizes="(min-width:1024px) 50vw, 100vw" loading="lazy" class="spatial-image" />
                <div class="spatial-label"><span>{s.code.toUpperCase().replace(' / ', ' / ')}</span><span>Component study</span></div>
              </div>
            ))}
            <div class="stage-controls"><button type="button" data-rotate="-18" aria-label="Putar ke kiri">↶</button><span>Gerakkan kursor · pilih sistem</span><button type="button" data-rotate="18" aria-label="Putar ke kanan">↷</button><button type="button" data-rotate="0" aria-label="Reset putaran">↺</button></div>
          </div>
        </div>
        <div class="machine-infos">
          {systems.map((s, i) => (
            <div data-info hidden={i !== 0}><span class="eyebrow">{s.kicker}</span><h3>{s.title}</h3><p>{s.description}</p><a class="text-link" href={`/program/basic-mechanic-course/modul/${s.slug}/`}>Detail modul <span aria-hidden="true">→</span></a><b class="font-mono text-xs text-gold">0{i + 1}—04</b></div>
          ))}
        </div>
      </div></div>
      <div class="scene-gate" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 05 Learning -->
  <section class="chapter" id="learning" data-ch="Belajar melalui praktik" data-chapter="learning" data-span="2.3">
    <div class="scene bg-green-grad">
      <div class="scene-pad wrap"><div class="scene-inner">
        <div class="split">
          <div><p class="eyebrow mb-4">05 / Learn by doing</p><h2 class="display" data-split>Masuk workshop.<br /><em>Temukan prosesmu.</em></h2></div>
          <div class="split-copy" data-reveal><p class="text-sage">Belajar mengamati, mencoba, mencatat, dan mengevaluasi bersama instruktur.</p><a class="text-link" href="/fasilitas/">Jelajahi fasilitas <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="rail-window"><ul class="rail" data-rail tabindex="0" aria-label="Tahapan belajar">
          {learning.map(([t, i], k) => <li data-title={t}><figure><Image src={img(i)} alt={t} widths={[640, 960, 1280]} sizes="(min-width:1000px) 540px, 78vw" loading="lazy" class="rail-img" style={pos(i)} /><figcaption><span>0{k + 1}</span><h3>{t}</h3></figcaption></figure></li>)}
        </ul></div>
        <div class="learning-footer">
          <div class="rail-controls"><button data-rail-prev aria-label="Sebelumnya">←</button><button data-rail-next aria-label="Berikutnya">→</button>
            <span class="rail-label"><b data-rail-count>01 / 04</b><span data-rail-label aria-live="polite">Classroom</span></span><span class="rail-bar" aria-hidden="true"><i data-rail-bar></i></span></div>
          <p class="font-mono text-xs text-sage">CLASSROOM → COMPONENT → PRACTICE → ASSESSMENT</p>
          <a class="text-link" href="/fasilitas/#galeri">Lihat 20 foto kegiatan <span aria-hidden="true">↗</span></a>
        </div>
      </div></div>
      <div class="scene-gate" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 06 Character -->
  <section class="chapter" id="character" data-ch="Mekanik berkarakter" data-chapter="character" data-span="1.7">
    <div class="scene isolate bg-ink">
      <div class="depth-photo"><Image src={img('bintalsik')} alt="Bintalsik di MEC Academy" widths={[800, 1600]} sizes="100vw" loading="lazy" class="h-full w-full object-cover" /></div>
      <div class="prayer-photo"><Image src={img('prayer')} alt="Sholat berjamaah di MEC Academy" widths={[800, 1600]} sizes="100vw" loading="lazy" class="h-full w-full object-cover" /></div>
      <div class="absolute inset-0 z-[-1] bg-gradient-to-r from-ink via-ink/75 to-ink/5"></div>
      <div class="scene-pad wrap"><div class="scene-inner">
        <p class="eyebrow mb-4">06 / Mekanik berkarakter</p>
        <h2 class="display max-w-2xl" data-split>Terampil<br />di tangan.<br /><em>Baik dalam<br />perbuatan.</em></h2>
        <p class="mt-6 max-w-md text-lg" data-reveal>Disiplin dan keselamatan dibiasakan. Tanggung jawab serta adab ditumbuhkan dalam keseharian.</p>
        <div class="saa" data-reveal><b>SAA</b><span>Sholat<br />Al-Qur’an<br />Adab</span></div>
        <p class="mt-6 font-mono text-xs text-gold">DISCIPLINE / SAFETY / RESPONSIBILITY</p>
      </div></div>
      <div class="character-beats" aria-hidden="true"><span style="--b:var(--b0)">Disiplin.</span><span style="--b:var(--b1)">Tanggung jawab.</span><span style="--b:var(--b2)">Adab.</span></div>
    </div>
  </section>

  <!-- 07 Instructors -->
  <section class="chapter on-paper" id="instructors" data-ch="Belajar bersama instruktur">
    <div class="scene bg-paper text-ink"><div class="scene-pad wrap"><div class="scene-inner">
      <div class="split">
        <div><p class="eyebrow mb-4">07 / Pengalaman yang dibagikan</p><h2 class="display" data-split>Belajar dari<br /><em>pengalaman industri.</em></h2></div>
        <p class="split-copy text-green" data-reveal>Kenali orang-orang yang mendampingi proses belajarmu di MEC Academy.</p>
      </div>
      <ul class="trainer-gallery">
        {content.instructors.map((p, i) => (
          <li data-reveal style={`--i:${i}`}><a class="trainer-card" href={`/instruktur/${slugify(p.name)}/`}>
            <span class="trainer-portrait"><Image src={img(p.asset)} alt={p.name} widths={[240, 400]} sizes="(min-width:1024px) 16vw, 45vw" loading="lazy" /></span>
            <span class="trainer-info"><strong>{p.name}</strong><span>Pengalaman: {p.company}</span><small>LIHAT PROFIL ↗</small></span></a></li>
        ))}
      </ul>
      <p class="mt-6 text-xs text-green">Riwayat pengalaman dan kompetensi instruktur · Company profile MEC 2026</p>
    </div></div></div>
  </section>

  <!-- 08 About -->
  <section class="chapter" id="about" data-ch="Tentang MEC">
    <div class="scene bg-green-grad"><div class="scene-pad wrap"><div class="scene-inner about-layout">
      <div class="about-visual">
        <Image src={img('building')} alt="Gedung MEC Academy" style={pos('building')} widths={[640, 960]} sizes="(min-width:1024px) 45vw, 100vw" loading="lazy" class="about-photo" />
        <div class="about-logo"><Image src={img('logo')} alt="MEC Academy" width={150} height={81} loading="lazy" /></div>
      </div>
      <div>
        <p class="eyebrow mb-4">08 / Mengenal MEC Academy</p><h2 class="display" data-split>Tempat belajar.<br /><em>Awal perjalanan.</em></h2>
        <p class="mt-6 max-w-xl text-sage" data-reveal>{content.institution} di Malang. Menghadirkan sumber daya manusia yang berkarakter baik untuk industri alat berat di Indonesia.</p>
        <ol class="timeline">{content.history.map((x) => <li><b>{x.year}</b><span>{x.name}</span></li>)}</ol>
        <div class="metrics"><article><strong>{content.metrics.alumni}</strong><span>Alumni menurut<br />company profile 2026</span></article><article><strong>{content.metrics.batch}</strong><span>Batch per<br />Agustus 2026</span></article></div>
        <div class="flex flex-wrap gap-6"><a class="text-link" href="/tentang/#identitas">Visi, misi & identitas <span aria-hidden="true">↗</span></a><a class="text-link" href="/tentang/#tim">Tim MEC <span aria-hidden="true">↗</span></a></div>
      </div>
    </div></div></div>
  </section>

  <!-- 09 Industry -->
  <section class="chapter" id="industry" data-ch="Terhubung dengan industri">
    <div class="scene bg-machine"><div class="scene-pad wrap"><div class="scene-inner">
      <div class="split">
        <div><p class="eyebrow mb-4">09 / Industry connection</p><h2 class="display" data-split>Membuka wawasan.<br /><em>Membangun hubungan.</em></h2></div>
        <p class="split-copy text-sage" data-reveal>Kunjungan dan kegiatan industri menghadirkan konteks dunia kerja dalam perjalanan MEC.</p>
      </div>
      <ul class="industry-grid">
        {events.map((e, i) => <li data-reveal style={`--i:${i}`}><figure><Image src={img(e.asset)} alt={`${e.name} — ${e.company}`} widths={[480, 720, 960]} sizes="(min-width:768px) 33vw, 78vw" loading="lazy" style={pos(e.asset)} /><figcaption><span>{e.name}</span>{e.company}</figcaption></figure></li>)}
      </ul>
      <p class="partner-label">Kegiatan bersama</p>
      <ul class="partner-chips">{[...new Set(content.events.map((e) => e.company))].map((c) => <li>{c}</li>)}</ul>
      <p class="partner-note">Dokumentasi kunjungan dan penyerahan komponen, bukan jaminan penempatan kerja.</p>
      <div class="flex flex-wrap gap-4"><a class="btn" href="/industri/">Lihat seluruh kegiatan <span aria-hidden="true">↗</span></a><a class="text-link" href="/industri/#kerja-sama">Kerja sama industri <span aria-hidden="true">↗</span></a></div>
    </div></div></div>
  </section>

  <!-- 10 Alumni & OJT -->
  <section class="chapter on-paper" id="alumni" data-ch="Alumni dan OJT">
    <div class="scene bg-paper text-ink"><div class="scene-pad wrap"><div class="scene-inner alumni-layout">
      <div>
        <p class="eyebrow mb-4">10 / From training to industry</p><h2 class="display" data-split>Proses hari ini.<br /><em>Bekal untuk<br />langkah berikutnya.</em></h2>
        <p class="mt-6 max-w-md text-green" data-reveal>On the Job Training mengembangkan keterampilan, wawasan, mental kerja, dan kemampuan berorganisasi dalam perusahaan.</p>
        <a class="btn mt-8" href={waLink('Halo MEC Academy, saya ingin berkonsultasi tentang program BMC dan On the Job Training. Mohon informasinya.')} target="_blank" rel="noopener">Tanya alur BMC & OJT <span aria-hidden="true">↗</span></a>
      </div>
      <div class="alumni-stack">
        <Image src={img('alumni2')} alt="Alumni MEC Academy di lokasi kerja" widths={[640, 960]} sizes="45vw" loading="lazy" class="alumni-back" />
        <Image src={img('alumni')} alt="Alumni MEC Academy bersama unit alat berat" widths={[640, 960]} sizes="45vw" loading="lazy" class="alumni-front" />
        <p class="alumni-caption">SETIAP PERJALANAN DIMULAI DARI BELAJAR.</p>
      </div>
    </div></div></div>
  </section>

  <!-- 11 Film -->
  <section class="chapter" id="film" data-ch="Company profile" data-chapter="film" data-span="1.25">
    <div class="scene isolate bg-ink">
      <div class="depth-photo film-bg"><Image src={img('film')} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="lazy" class="h-full w-full object-cover" /></div>
      <div class="absolute inset-0 z-[-1] bg-gradient-to-t from-ink/95 via-ink/45 to-ink/65"></div>
      <div class="scene-pad wrap"><div class="scene-inner film-content">
        <p class="eyebrow mb-4">11 / Mengenal lebih dekat</p>
        <h2 class="display" data-split>Inilah<br /><em>MEC Academy.</em></h2>
        <button class="play-button" data-video-open="ZV39to3Qfz8" aria-label="Putar video company profile MEC Academy"><span aria-hidden="true">▷</span></button>
        <p class="mt-6 max-w-sm text-sm">Temukan proses, orang-orang, dan semangat di balik pelatihan.</p>
        <a class="text-link" href={content.video.watch} rel="noopener" target="_blank">Tonton di YouTube <span aria-hidden="true">↗</span></a>
      </div></div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="wrap pb-20 pt-20" aria-label="Artikel terbaru">
      <div class="mb-8 flex items-end justify-between"><h2 class="text-4xl md:text-5xl">Artikel terbaru</h2><a class="text-link" href="/artikel/">Semua artikel <span aria-hidden="true">↗</span></a></div>
      <ul class="grid gap-6 md:grid-cols-3">
        {latest.map((a) => <li><a class="block h-full border border-line p-6 hover:border-gold" href={`/artikel/${a.id}/`}><p class="eyebrow">{categories[a.data.category]}</p><h3 class="mt-2 text-2xl">{a.data.title}</h3><p class="mt-3 text-sm text-sage">{a.data.description}</p></a></li>)}
      </ul>
    </section>
  )}

  <section class="wrap faq-strip" aria-labelledby="faq-title">
    <div class="split"><div><p class="eyebrow mb-4">Sebelum mendaftar</p><h2 id="faq-title" class="display">Pertanyaan<br /><em>yang sering muncul.</em></h2></div>
      <div class="split-copy"><p class="text-sage">Jawaban singkat tentang seleksi, materi, fasilitas, dan biaya.</p><a class="text-link" href="/faq/">Semua pertanyaan <span aria-hidden="true">↗</span></a></div></div>
    <div class="faq-list">{faq.filter((f) => f.home).map((f) => <details class="faq"><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div>
  </section>

  <!-- 12 Contact -->
  <section class="chapter" id="contact" data-ch="Mulai BMC">
