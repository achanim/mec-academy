---
import { Image } from 'astro:assets';
import Page from '../../components/Page.astro';
import { img } from '../../lib/images';
import { slugify } from '../../lib/site';
import content from '../../data/content.json';
---
<Page title="Instruktur MEC Academy" eyebrow="Pengalaman yang dibagikan" description="Instruktur berpengalaman di industri alat berat dan bersertifikat BNSP yang mendampingi proses belajarmu.">
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {content.instructors.map((p) => (
      <li class="border-t-2 border-gold bg-paper/5 p-5">
        <Image src={img(p.asset)} alt={p.name} widths={[320, 480]} class="mb-4 h-64 w-full object-cover object-top" loading="lazy" />
        <h2 class="text-2xl"><a class="hover:text-gold" href={`/instruktur/${slugify(p.name)}/`}>{p.name}</a></h2>
        <p class="text-sm text-sage">{p.role} · Pengalaman: {p.company}</p>
        <ul class="mt-3 flex flex-wrap gap-2 text-xs">{p.credentials.map((c) => <li class="border border-line px-2 py-1">{c}</li>)}</ul>
      </li>
    ))}
  </ul>
</Page>
