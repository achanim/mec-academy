---
import Page from '../../components/Page.astro';
import content from '../../data/content.json';
import research from '../../data/research.json';
---
<Page title="Sumber Informasi" eyebrow="Transparansi" description="Daftar sumber yang dipakai di situs MEC Academy beserta batas penggunaan masing-masing.">
  <p class="mb-10 max-w-2xl text-sage">Informasi lembaga bersumber dari <b>{content.source}</b> ({content.source_pages} halaman). Konteks industri dan kebijakan di bawah ini dipakai sebagai latar, bukan sebagai klaim tentang MEC.</p>
  <ul class="grid gap-6 md:grid-cols-2">
    {research.sources.map((s) => (
      <li class="border-t-2 border-gold pt-4">
        <p class="font-mono text-[11px] uppercase text-gold">{s.publisher}{s.date ? ` · ${s.date}` : ''}</p>
        <h2 class="mt-2 text-2xl"><a class="hover:text-gold" href={s.url} target="_blank" rel="noopener">{s.title} ↗</a></h2>
        <p class="mt-3 text-sm">{s.summary}</p>
        <p class="mt-3 text-xs text-sage"><b>Batas penggunaan:</b> {s.scope}</p>
      </li>
    ))}
  </ul>
  <h2 class="mb-4 mt-16 text-3xl">Catatan editorial</h2>
  <ul class="list-disc space-y-2 pl-5 text-sm text-sage">{research.editorial_rules.map((r) => <li>{r}</li>)}</ul>
</Page>
