---
import { Image } from 'astro:assets';
import Page from '../../components/Page.astro';
import { publishedArticles, categories } from '../../lib/articles';
const articles = await publishedArticles();
---
<Page title="Artikel" image="teaching" imageAlt="Siswa MEC mencatat pengamatan komponen" eyebrow="Wawasan" description="Artikel seputar karier mekanik alat berat, pengetahuan teknis, K3, dan dunia industri dari tim MEC Academy.">
  <div id="search" class="mb-8" aria-busy="true"><div class="skeleton h-12 w-full max-w-xl" role="status" aria-label="Memuat pencarian"></div></div>
  <ul class="article-chips mb-10 flex flex-wrap gap-3 text-sm">{Object.entries(categories).map(([k, v]) => <li><a class="border border-line px-3 py-1 hover:border-gold" href={`/artikel/kategori/${k}/`}>{v}</a></li>)}</ul>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {articles.map((a, i) => (
      <li class:list={['article-card', i === 0 && articles.length < 3 && 'featured']}><a href={`/artikel/${a.id}/`}>
        {a.data.cover ? <Image src={a.data.cover} alt={a.data.coverAlt ?? ''} widths={[480, 800]} sizes="(min-width:1024px) 33vw, 100vw" loading="lazy" class="article-cover" /> : <div class="article-cover article-cover-empty" aria-hidden="true">MEC</div>}
        <div class="article-body"><p class="eyebrow">{categories[a.data.category]}</p>
        <h2>{a.data.title}</h2>
        <p class="text-sm text-sage">{a.data.description}</p>
        <time class="mt-4 block text-xs text-sage" datetime={a.data.publishedAt.toISOString()}>{a.data.publishedAt.toLocaleDateString('id-ID', { dateStyle: 'long' })}</time></div>
      </a></li>
    ))}
  </ul>
  {articles.length === 0 && <p class="text-sage">Belum ada artikel.</p>}
  <script>import '../../scripts/search.ts';</script>
</Page>
