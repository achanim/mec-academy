---
import Page from '../../components/Page.astro';
import { publishedArticles, categories } from '../../lib/articles';
const articles = await publishedArticles();
---
<Page title="Artikel" eyebrow="Wawasan" description="Artikel seputar karier mekanik alat berat, pengetahuan teknis, K3, dan dunia industri dari tim MEC Academy.">
  <div id="search" class="mb-8"></div>
  <ul class="mb-10 flex flex-wrap gap-3 text-sm">{Object.entries(categories).map(([k, v]) => <li><a class="border border-line px-3 py-1 hover:border-gold" href={`/artikel/kategori/${k}/`}>{v}</a></li>)}</ul>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {articles.map((a) => (
      <li><a class="block h-full border border-line p-6 hover:border-gold" href={`/artikel/${a.id}/`}>
        <p class="eyebrow">{categories[a.data.category]}</p>
        <h2 class="mt-3 text-3xl">{a.data.title}</h2>
        <p class="mt-3 text-sm text-sage">{a.data.description}</p>
        <time class="mt-4 block text-xs text-sage/70" datetime={a.data.publishedAt.toISOString()}>{a.data.publishedAt.toLocaleDateString('id-ID', { dateStyle: 'long' })}</time>
      </a></li>
    ))}
  </ul>
  {articles.length === 0 && <p class="text-sage">Belum ada artikel.</p>}
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>window.addEventListener('DOMContentLoaded', () => { if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: false, translations: { placeholder: 'Cari artikel…' } }); });</script>
</Page>
