---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { publishedArticles, categories, readingMinutes } from '../../lib/articles';
import { site, waLink } from '../../lib/site';
export async function getStaticPaths() {
  const articles = await publishedArticles();
  return articles.map((a) => ({ params: { slug: a.id }, props: { a, related: articles.filter((r) => r.id !== a.id && r.data.category === a.data.category).slice(0, 3) } }));
}
const { a, related } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld: object[] = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, datePublished: d.publishedAt.toISOString(), dateModified: (d.updatedAt ?? d.publishedAt).toISOString(), author: { '@type': 'Person', name: d.author }, publisher: { '@type': 'Organization', name: site.name }, mainEntityOfPage: url, inLanguage: 'id', ...(d.cover ? { image: new URL(d.cover.src, Astro.site).href } : {}) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Beranda', '/'], ['Artikel', '/artikel/'], [d.title, Astro.url.pathname]].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, Astro.site).href })) },
];
if (d.faq.length) ld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.title} description={d.description} type="article" publishedAt={d.publishedAt} updatedAt={d.updatedAt} image={d.cover?.src} jsonLd={ld}>
  <article class="wrap py-16" data-pagefind-body>
    <nav aria-label="Breadcrumb" class="eyebrow mb-6"><a href="/">Beranda</a> / <a href="/artikel/">Artikel</a> / <a href={`/artikel/kategori/${d.category}/`}>{categories[d.category]}</a></nav>
    <h1 class="title-case">{d.title}</h1>
    <p class="mt-4 text-sm text-sage">{d.author} · <time datetime={d.publishedAt.toISOString()}>{d.publishedAt.toLocaleDateString('id-ID', { dateStyle: 'long' })}</time>{d.updatedAt && <> · Diperbarui <time datetime={d.updatedAt.toISOString()}>{d.updatedAt.toLocaleDateString('id-ID', { dateStyle: 'long' })}</time></>} · {readingMinutes(a.body)} menit baca</p>
    {d.cover && <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1024, 1600]} sizes="(min-width:1024px) 1000px, 100vw" loading="eager" class="my-10 max-h-[520px] w-full max-w-5xl object-cover" />}
    <div class="prose-mec mt-10"><Content /></div>
    {d.faq.length > 0 && (<section class="prose-mec mt-14"><h2>Pertanyaan umum</h2>{d.faq.map((f) => <details class="border-t border-line py-3"><summary class="cursor-pointer font-bold">{f.q}</summary><p>{f.a}</p></details>)}</section>)}
    <aside class="mt-16 border border-gold/40 p-8"><h2 class="text-3xl">Siap memulai langkahmu?</h2><p class="mt-2 text-sage">Tanyakan jadwal, biaya, dan persyaratan BMC.</p><a class="btn mt-5" href={waLink()} target="_blank" rel="noopener">Daftar BMC ↗</a></aside>
    {related.length > 0 && (<section class="mt-16"><h2 class="mb-4 text-3xl">Baca juga</h2><ul class="space-y-2">{related.map((r) => <li><a class="text-gold underline" href={`/artikel/${r.id}/`}>{r.data.title}</a></li>)}</ul></section>)}
  </article>
</Base>
