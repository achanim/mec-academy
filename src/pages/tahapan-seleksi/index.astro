---
import Page from '../../components/Page.astro';
import content from '../../data/content.json';
---
<Page title="Tahapan Seleksi & Pelatihan BMC" image="classroom" imageAlt="Kelas MEC Academy" eyebrow="Perjalananmu di MEC" description="Alur BMC: assessment, in-class training 3 bulan, lalu On the Job Training 6–12 bulan, lengkap dengan persyaratan peserta.">
  <ol class="grid gap-8 md:grid-cols-3">
    {content.stages.map((s, i) => (
      <li class="border-t-2 border-gold pt-5"><span class="font-mono text-gold">0{i + 1}</span><h2 class="mt-2 text-3xl">{s.name}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sage">{s.items.map((it) => <li>{it}</li>)}</ul></li>
    ))}
  </ol>
  <h2 class="mb-6 mt-16 text-4xl">Persyaratan peserta</h2>
  <div class="grid gap-8 md:grid-cols-3">
    {[['Calon siswa (administrasi)', content.requirements.admin], ['Peserta in-class training', content.requirements.inclass], ['Peserta On the Job Training', content.requirements.ojt]].map(([t, items]) => (
      <div class="border-t-2 border-gold pt-4"><h3 class="text-2xl">{t}</h3><ul class="mt-3 list-disc space-y-2 pl-5 text-sage">{(items as string[]).map((it) => <li>{it}</li>)}</ul></div>
    ))}
  </div>
  <p class="mt-8 text-xs text-sage">Sumber: situs MEC Academy; konfirmasi persyaratan terbaru ke tim MEC.</p>
</Page>
