---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { img } from '../../lib/images';
import { site, waLink } from '../../lib/site';
const steps = [
  ['Siapkan akunmu.', 'Pastikan username dan password sudah kamu terima dari tim assessor MEC Academy.'],
  ['Masuk ke portal.', 'Klik Login Assessment, lalu masukkan akunmu pada halaman login yang terbuka.'],
  ['Ikuti petunjuknya.', 'Baca petunjuk pada portal dan arahan assessor sebelum mulai mengerjakan assessment.'],
];
const faq = [
  ['Siapa yang dapat mengikuti assessment?', 'Halaman ini ditujukan untuk calon siswa dan siswa BMC yang telah memperoleh akun dari tim assessor MEC Academy.'],
  ['Bagaimana mendapatkan username dan password?', 'Akun diberikan oleh tim assessor. Jika belum mendapatkannya, hubungi tim MEC untuk informasi akses.'],
  ['Ke mana tombol Login Assessment mengarah?', 'Tombol tersebut membuka portal ujian MEC Academy. Masukkan username dan password pada halaman login portal tersebut.'],
  ['Bagaimana jika saya mengalami kendala login?', 'Periksa kembali akun yang diberikan assessor. Jika masih mengalami kendala, hubungi tim MEC untuk mendapatkan bantuan.'],
];
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Base title="Assessment Online" description="Assessment online untuk calon siswa dan siswa Basic Mechanic Course. Siapkan username dan password dari tim assessor MEC Academy." jsonLd={ld}>
  <section class="as-hero">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="eyebrow mb-12"><a href="/">Beranda</a> <span aria-hidden="true">/</span> <span aria-current="page" class="text-gold">Assessment</span></nav>
      <div class="grid items-center gap-14 md:grid-cols-[1.1fr_1fr]">
        <div>
          <p class="eyebrow mb-4">MEC Academy / Assessment online</p>
          <h1 class="display">Ukur<br /><em>pemahamanmu.</em></h1>
          <p class="mt-6 max-w-lg text-lg">Assessment online untuk calon siswa dan siswa <b>Basic Mechanic Course.</b></p>
          <p class="mt-3 max-w-lg text-sage">Siapkan username dan password yang diberikan tim assessor MEC Academy sebelum masuk ke portal ujian.</p>
          <div class="mt-8 flex flex-wrap items-center gap-6"><a class="btn" href={site.assessmentUrl} rel="noopener">Login Assessment <span aria-hidden="true">↗</span></a><a class="text-link !mt-0" href="#panduan">Panduan masuk <span aria-hidden="true">↓</span></a></div>
          <p class="mt-5 text-xs text-sage">↗ Masuk ke portal ujian MEC Academy.</p>
          <p class="mt-8 flex items-center gap-4 font-mono text-xs text-gold">CALON SISWA <i class="h-px w-10 bg-gold"></i> SISWA BMC</p>
        </div>
        <div class="relative pb-16">
          <figure class="border-t-[3px] border-gold"><Image src={img('teaching')} alt="Siswa MEC mencatat pengamatan komponen" widths={[640, 960]} sizes="(min-width:768px) 45vw, 100vw" loading="eager" class="h-[400px] w-full object-cover" /><figcaption class="bg-ink p-3 font-mono text-xs text-gold">BELAJAR. BERLATIH. MENGEVALUASI.</figcaption></figure>
          <a href={site.assessmentUrl} rel="noopener" class="account-card"><span><small>AKSES PESERTA</small><b>Gunakan akun dari<br />tim assessor MEC.</b></span><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="panduan" class="bg-paper py-20 text-ink scroll-mt-24">
    <div class="wrap">
      <div class="split"><div><p class="eyebrow !text-green mb-4">01 / Sebelum memulai</p><h2 class="display text-ink">Tiga langkah.<br /><em class="!text-green">Siap mengikuti.</em></h2></div><p class="split-copy text-green">Ikuti arahan tim assessor untuk pelaksanaan assessment yang akan kamu jalani.</p></div>
      <ol class="grid gap-8 md:grid-cols-3">{steps.map(([t, d], i) => <li class="border-t-2 border-green pt-4"><span class="font-mono text-xs text-green">0{i + 1}</span><h3 class="mt-2 text-3xl text-green">{t}</h3><p class="mt-2 text-sm">{d}</p></li>)}</ol>
      <aside class="mt-12 flex flex-wrap items-center justify-between gap-4 border border-green/30 p-6"><div><b class="font-display text-2xl uppercase text-green">Belum punya akun?</b><p class="text-sm">Hubungi tim MEC untuk informasi akses assessment.</p></div><a class="btn" target="_blank" rel="noopener" href={waLink('Halo MEC Academy, saya ingin bertanya tentang akses akun assessment. Mohon bantuannya.')}>Tanya akses akun ↗</a></aside>
    </div>
  </section>

  <section class="bg-deep py-20">
    <div class="wrap grid gap-12 md:grid-cols-[.9fr_1.25fr]">
      <div><p class="eyebrow mb-4">02 / Informasi peserta</p><h2 class="display">Sebelum<br /><em>kamu login.</em></h2><p class="mt-6 max-w-xs text-sage">Informasi singkat untuk memulai assessment.</p></div>
      <div>{faq.map(([q, a]) => <details class="faq"><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="border-y border-line bg-gradient-to-r from-[#315f61] via-green to-deep py-14">
    <div class="wrap flex flex-wrap items-center justify-between gap-8"><div><p class="eyebrow mb-3">Langkah berikutnya</p><h2 class="display">Akun sudah siap?</h2><p class="mt-3 text-sage">Masuk dan ikuti assessment sesuai arahan tim MEC.</p></div><a class="btn" href={site.assessmentUrl} rel="noopener">Login Assessment <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>
