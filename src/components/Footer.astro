---
import { site } from '../lib/site';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="font-display text-3xl font-bold uppercase">MEC <span class="text-gold">Academy</span></p>
      <p class="mt-3 max-w-xs text-sm text-sage">Mekanik berkarakter. Lembaga pelatihan teknik alat berat di Malang.</p>
      <address class="mt-5 text-sm not-italic leading-7 text-sage">{site.address}<br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></address>
    </div>
    <nav aria-label="Pintasan"><h2>Pintasan</h2><ul><li><a href="/">Beranda</a></li><li><a href="/#program">16 modul</a></li><li><a href="/#fasilitas">Fasilitas</a></li><li><a href="/#kontak">Kontak</a></li></ul></nav>
  </div>
  <p class="wrap footer-copy">© {new Date().getFullYear()} MEC Academy · Mekanik Berkarakter</p>
</footer>
