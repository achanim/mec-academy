---
import { site } from '../lib/site';
const cols = [
  ['Program', [['/program/basic-mechanic-course/', 'Basic Mechanic Course'], ['/program/basic-mechanic-course/modul/', '16 modul'], ['/tahapan-seleksi/', 'Tahapan seleksi'], ['/faq/', 'FAQ']]],
  ['Lembaga', [['/tentang/', 'Tentang'], ['/instruktur/', 'Instruktur'], ['/industri/', 'Industri'], ['/alumni/', 'Alumni'], ['/fasilitas/', 'Fasilitas']]],
  ['Lainnya', [['/artikel/', 'Artikel'], ['/assessment/', 'Assessment online'], ['/sumber/', 'Sumber informasi'], ['/kontak/', 'Kontak']]],
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="font-display text-3xl font-bold uppercase">MEC <span class="text-gold">Academy</span></p>
      <p class="mt-3 max-w-xs text-sm text-sage">Mekanik berkarakter. Lembaga pelatihan teknik alat berat di Malang.</p>
      <address class="mt-5 text-sm not-italic leading-7 text-sage">{site.address}<br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.hoursLabel}</address>
      <ul class="social-icons" aria-label="Media sosial dan lokasi">
        <li><a href={site.mapsUrl} target="_blank" rel="noopener" aria-label="Lokasi MEC Academy di Google Maps" title="Google Maps"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg></a></li>
        <li><a href={site.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram MEC Academy" title="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></li>
        <li><a href={site.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn MEC Academy" title="LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.54h.05c.53-1 1.82-2.04 3.75-2.04 4 0 4.75 2.63 4.75 6.05V21h-4v-5.05c0-1.2-.02-2.75-1.68-2.75-1.68 0-1.94 1.31-1.94 2.66V21h-4V9.75Z"/></svg></a></li>
      </ul>
    </div>
    {cols.map(([t, links]) => <nav aria-label={t as string}><h2>{t}</h2><ul>{(links as string[][]).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul></nav>)}
  </div>
  <p class="wrap footer-copy">© {new Date().getFullYear()} MEC Academy · Mekanik Berkarakter</p>
</footer>
