---
import { site } from '../lib/site';
const cols = [
  ['Program', [['/program/basic-mechanic-course/', 'Basic Mechanic Course'], ['/program/basic-mechanic-course/modul/', '16 modul'], ['/tahapan-seleksi/', 'Tahapan seleksi'], ['/faq/', 'FAQ']]],
  ['Lembaga', [['/tentang/', 'Tentang'], ['/instruktur/', 'Instruktur'], ['/industri/', 'Industri'], ['/fasilitas/', 'Fasilitas']]],
  ['Lainnya', [['/artikel/', 'Artikel'], ['/assessment/', 'Assessment online'], ['/sumber/', 'Sumber informasi'], ['/kontak/', 'Kontak']]],
];
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="font-display text-3xl font-bold uppercase">MEC <span class="text-gold">Academy</span></p>
      <p class="mt-3 max-w-xs text-sm text-sage">Mekanik berkarakter. Lembaga pelatihan teknik alat berat di Malang.</p>
      <address class="mt-5 text-sm not-italic leading-7 text-sage">{site.address}<br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></address>
    </div>
    {cols.map(([t, links]) => <nav aria-label={t as string}><h2>{t}</h2><ul>{(links as string[][]).map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul></nav>)}
  </div>
  <p class="wrap footer-copy">© {new Date().getFullYear()} MEC Academy · Mekanik Berkarakter</p>
</footer>
