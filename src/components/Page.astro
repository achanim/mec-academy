---
// Layout halaman konten: banner (opsional berfoto) + slot
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img, pos } from '../lib/images';
interface Props { title: string; description: string; eyebrow?: string; heading?: string; image?: string; imageAlt?: string; jsonLd?: object | object[]; titleCase?: boolean; }
const { title, description, eyebrow, heading = title, image, imageAlt = '', jsonLd, titleCase = false } = Astro.props;
---
<Base {title} {description} {jsonLd}>
  <section class:list={['page-hero', image && 'has-photo']}>
    {image && <Image src={img(image)} alt={imageAlt} widths={[800, 1280, 1920]} sizes="100vw" loading="eager" class="page-hero-photo" style={pos(image)} />}
    <div class="wrap page-hero-inner">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h1 class:list={['page-title', titleCase && 'title-case']}>{heading}</h1>
      <p class="mt-6 max-w-2xl text-lg text-sage">{description}</p>
    </div>
  </section>
  <div class="wrap py-16"><slot /></div>
</Base>
