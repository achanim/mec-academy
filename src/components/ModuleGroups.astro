---
import { moduleGroups } from '../lib/modules';
interface Props { headingTag?: 'h2' | 'h3' }
const { headingTag: H = 'h3' } = Astro.props;
---
<div class="module-groups">
  {moduleGroups.map((g) => (
    <section class="module-group">
      <header><H>{g.title}</H><p>{g.note}</p></header>
      <ul>
        {g.items.map((m) => <li><a href={`/#modul-${m.slug}`} data-open={`modul-${m.slug}`}><span>{String(m.n).padStart(2, '0')}</span><b>{m.title}</b><i aria-hidden="true">→</i></a></li>)}
      </ul>
    </section>
  ))}
</div>
