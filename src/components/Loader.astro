---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
---
<div id="loader" class="loader" role="dialog" aria-modal="true" aria-labelledby="loader-title">
  <div class="loader-body">
    <div class="logo-frame loader-logo"><Image src={img('logo')} alt="MEC Academy" width={150} height={82} loading="eager" /></div>
    <p class="eyebrow">Sebuah langkah menuju industri</p>
    <h2 id="loader-title">Siap memulai<br />perjalananmu?</h2>
    <div class="load-track"><span id="load-fill"></span></div>
    <div class="load-info"><span id="load-status" role="status">Menyiapkan pengalaman MEC</span><span id="load-percent">0%</span></div>
    <p class="load-detail" id="load-detail">Foto · identitas · pengalaman belajar</p>
    <button class="btn" type="button" id="enter-mec" disabled>Mulai perjalanan <span aria-hidden="true">↗</span></button>
    <button class="text-link" type="button" id="enter-calm">Masuk dengan gerak minimal</button>
  </div>
  <span class="loader-foot">Kompeten. Berkarakter. Siap memasuki dunia kerja.</span>
</div>
