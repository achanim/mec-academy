---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import { site, waLink } from '../lib/site';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const nav = [
  ['/tentang/', 'Tentang'],
  ['/program/basic-mechanic-course/', 'Program'],
  ['/fasilitas/', 'Fasilitas'],
  ['/#alumni', 'Alumni'],
  ['/artikel/', 'Artikel'],
  ['/assessment/', 'Assessment'],
];
const menuItems = [
  ['/', 'Beranda', 'Mulai dari awal'],
  ['/tentang/', 'Tentang', 'Sejarah, visi & tim'],
  ['/program/basic-mechanic-course/', 'Program', 'Basic Mechanic Course'],
  ['/fasilitas/', 'Fasilitas', 'Workshop & galeri kegiatan'],
  ['/#alumni', 'Alumni', 'Dari pelatihan ke industri'],
  ['/artikel/', 'Artikel', 'Wawasan seputar alat berat'],
  ['/assessment/', 'Assessment', 'Portal ujian online'],
  ['/instruktur/', 'Instruktur', 'Pengalaman industri'],
  ['/industri/', 'Industri', 'Kunjungan & kerja sama'],
  ['/kontak/', 'Kontak', 'Jadwal, biaya, persyaratan'],
];
const path = Astro.url.pathname;
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-5 focus:z-[1000] focus:bg-gold focus:text-ink focus:p-3">Langsung ke konten</a>
<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo-frame" aria-label={`${site.name} — beranda`}><Image src={img('logo')} alt="MEC Academy" width={105} height={57} loading="eager" /></a>
    <nav class="desktop-nav" aria-label="Navigasi utama">
      {nav.map(([href, label]) => <a href={href} aria-current={href.startsWith('/#') ? undefined : path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      {home && <button class="motion-control" type="button" id="motion-toggle" aria-pressed="false" aria-label="Aktifkan mode tenang, kurangi animasi">Gerak <span>aktif</span></button>}
      <a class="btn compact" href={waLink()} target="_blank" rel="noopener">Daftar BMC <span aria-hidden="true">↗</span></a>
      <button class="menu-control" type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu" aria-label="Buka menu"><span></span><span></span></button>
    </div>
  </div>
</header>
<div id="menu" class="menu-panel" hidden>
  <div class="menu-inner">
    <nav aria-label="Menu">
      <ul class="menu-grid">
        {menuItems.map(([href, label, desc], i) => (
          <li style={`--i:${i}`}><a href={href}><span class="menu-no">{String(i + 1).padStart(2, '0')}</span><b>{label}</b><small>{desc}</small><i aria-hidden="true">↗</i></a></li>
        ))}
      </ul>
    </nav>
    <div class="menu-foot">
      <p>{site.phone} · {site.email}</p>
      <a class="btn compact" href={waLink()} target="_blank" rel="noopener">Daftar BMC <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</div>
