---
import { site, waLink } from '../lib/site';
const nav = [
  ['/program/basic-mechanic-course/', 'Program'],
  ['/tahapan-seleksi/', 'Tahapan'],
  ['/fasilitas/', 'Fasilitas'],
  ['/instruktur/', 'Instruktur'],
  ['/artikel/', 'Artikel'],
  ['/tentang/', 'Tentang'],
];
const path = Astro.url.pathname;
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-5 focus:z-[1000] focus:bg-gold focus:text-ink focus:p-3">Langsung ke konten</a>
<header class="fixed inset-x-0 top-0 z-50 border-b border-gold/20 bg-gradient-to-r from-deep/95 to-ink/95 backdrop-blur">
  <div class="wrap flex h-20 items-center gap-8">
    <a href="/" class="font-display text-2xl tracking-wide" aria-label={`${site.name} — beranda`}>MEC <span class="text-gold">Academy</span></a>
    <nav class="ml-4 hidden gap-6 text-sm md:flex" aria-label="Utama">
      {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined} class="hover:text-gold aria-[current=page]:text-gold">{label}</a>)}
    </nav>
    <a href={waLink()} class="btn ml-auto text-sm" rel="noopener" target="_blank">Daftar BMC ↗</a>
  </div>
</header>
