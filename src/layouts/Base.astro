---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import fontDisplay from '../assets/fonts/ArchivoNarrow-700.woff2?url';
import fontBody from '../assets/fonts/Archivo-400.woff2?url';
import fontBold from '../assets/fonts/Archivo-700.woff2?url';
import fontMono from '../assets/fonts/MECMono.woff2?url';
import { site } from '../lib/site';
interface Props { title: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; home?: boolean; footer?: boolean; jsonLd?: object | object[]; publishedAt?: Date; updatedAt?: Date; }
const { home = false, footer = true, ...props } = Astro.props;
const orgLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: 'Malang Education Center',
  url: site.url,
  logo: `${site.url}/apple-touch-icon.png`,
  image: `${site.url}/og-default.jpg`,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Kabupaten Malang', addressRegion: 'Jawa Timur', addressCountry: 'ID' },
  hasMap: site.mapsUrl,
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', telephone: site.phone, areaServed: 'ID', availableLanguage: ['id'] },
  ...(site.social.length ? { sameAs: site.social } : {}),
  ...(site.geo ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } } : {}),
  ...(site.openingHours.length ? { openingHoursSpecification: site.openingHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })) } : {}),
};
const extra = props.jsonLd ? (Array.isArray(props.jsonLd) ? props.jsonLd : [props.jsonLd]) : [];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#265154" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {home && <script is:inline>try{if(!sessionStorage.getItem('mec-intro')&&!/bot|crawl|spider|slurp|lighthouse|pagespeed|headless|prerender/i.test(navigator.userAgent))document.documentElement.classList.add('intro-pending')}catch(e){}</script>}
    <link rel="preload" as="font" type="font/woff2" href={fontDisplay} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontBody} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontBold} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontMono} crossorigin />
    {home && <script is:inline>try{var m=matchMedia,c=navigator.connection;if(m('(min-width:1000px)').matches&&!m('(pointer:coarse)').matches&&!m('(prefers-reduced-motion:reduce)').matches&&innerHeight>=700&&localStorage.getItem('mec-calm')!=='1'&&!(c&&c.saveData))document.documentElement.classList.add('motion-pre')}catch(e){}</script>}
    <Seo {...props} jsonLd={[orgLd, ...extra]} />
    {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.analytics.src && <script is:inline defer src={site.analytics.src} {...site.analytics.attrs}></script>}
  </head>
  <body>
    {home && <Loader />}
    <Header home={home} />
    <main id="main" class={home ? '' : 'pt-20'}><slot /></main>
    {footer && <Footer />}
    <div id="toast" role="status" aria-live="polite"></div>
    <noscript><style>.skeleton{display:none}img{opacity:1!important}</style></noscript>
    <script>import '../scripts/resilience.ts'; import '../scripts/ui.ts';</script>
  </body>
</html>
