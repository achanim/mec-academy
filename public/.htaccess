# Konfigurasi Apache/LiteSpeed untuk hosting cPanel (Rumahweb). Ikut tersalin ke dist/ saat build.
# (_headers dan _redirects hanya dipakai Cloudflare/Netlify, diabaikan di sini.)
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS + tanpa "www" (satu alamat kanonik: https://malangeducationcenter.com)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://malangeducationcenter.com%{REQUEST_URI} [L,R=301]

# 2. Alamat lama (situs Hostinger/Zyro dan struktur multi-halaman) -> beranda + dialog (hash ikut dibawa: NE)
RewriteRule ^organisasi/?$                       /#about [L,R=301,NE]
RewriteRule ^galeri/?$                           /#fasilitas [L,R=301,NE]
RewriteRule ^alumni/?$                           /#alumni [L,R=301,NE]
RewriteRule ^hubungi-kami/?$                     /#kontak [L,R=301,NE]
RewriteRule ^learning/?$                         /#program [L,R=301,NE]
RewriteRule ^program/basic-mechanic-course/modul/([a-z0-9-]+)/?$ /#modul-$1 [L,R=301,NE]
RewriteRule ^program(/.*)?$                      /#program [L,R=301,NE]
RewriteRule ^instruktur/([a-z0-9-]+)/?$          /#instruktur-$1 [L,R=301,NE]
RewriteRule ^instruktur/?$                       /#instructors [L,R=301,NE]
RewriteRule ^tahapan-seleksi/?$                  /#tahapan [L,R=301,NE]
RewriteRule ^fasilitas/?$                        /#fasilitas [L,R=301,NE]
RewriteRule ^faq/?$                              /#faq [L,R=301,NE]
RewriteRule ^kontak/?$                           /#kontak [L,R=301,NE]
RewriteRule ^tentang/?$                          /#about [L,R=301,NE]
RewriteRule ^industri/?$                         /#industry [L,R=301,NE]
RewriteRule ^(sumber|assessment|artikel)(/.*)?$  / [L,R=301]
</IfModule>

# 3. Halaman error
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# 4. Kompresi
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# 5. Cache: berkas _astro/ bernama hash (aman 1 tahun); HTML selalu dicek ulang
<IfModule mod_headers.c>
<FilesMatch "\.(html|xml)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2|webp|avif|jpg|jpeg|png|svg|ico)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/_astro/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
<IfModule mod_mime.c>
AddType application/javascript .js
AddType font/woff2 .woff2
</IfModule>
