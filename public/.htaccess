# Konfigurasi Apache/LiteSpeed untuk hosting cPanel (Rumahweb). Ikut tersalin ke dist/ saat build.
# (_headers dan _redirects hanya dipakai Cloudflare/Netlify, diabaikan di sini.)
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS + tanpa "www" (satu alamat kanonik: https://malangeducationcenter.com)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://malangeducationcenter.com%{REQUEST_URI} [L,R=301]

# 2. Alamat lama (situs Hostinger/Zyro) -> alamat baru
RewriteRule ^organisasi/?$     /tentang/ [L,R=301]
RewriteRule ^galeri/?$         /fasilitas/ [L,R=301]
RewriteRule ^hubungi-kami/?$   /kontak/ [L,R=301]
RewriteRule ^learning/?$       /program/basic-mechanic-course/ [L,R=301]
RewriteRule ^syarat-in-class/?$  /tahapan-seleksi/ [L,R=301]
# Halaman contoh bawaan templat Hostinger yang ikut terindeks (produk dll.) -> 410 Gone agar keluar dari indeks Google
RewriteRule ^(classic-cap-hpeszv|creative-course-session|face-serum-gxrcld|group-fitness-class|handmade-vase-slowpy|hand-soap-giguos|individual-coaching-session|intro-language-tutoring-session|set-of-plates-cxlzwx|sunglasses-iubjnq|wooden-chair-mopukh|wool-sweater-lortoo|the-first-90-days-postpartum-.*)/?$ - [G,L]
RewriteRule ^program/?$        /program/basic-mechanic-course/ [L,R=301]
RewriteRule ^artikel/kategori/?$ /artikel/ [L,R=301]
# /assessment sudah sama; garis miring penutup ditambahkan otomatis oleh Apache (mod_dir)
</IfModule>

# 3. Halaman error
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# 4. Kompresi
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# 5. Cache: berkas _astro/ bernama hash (aman 1 tahun); HTML selalu dicek ulang
<IfModule mod_headers.c>
<FilesMatch "\.(html|xml)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2|webp|avif|jpg|jpeg|png|svg|ico)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/_astro/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
<IfModule mod_mime.c>
AddType application/javascript .js
AddType font/woff2 .woff2
</IfModule>


# PHP 8.3 untuk /kelola-foto/ (pengelola foto alumni). Blok ini ditulis cPanel (MultiPHP Manager) dan
# disalin ke sini supaya tidak hilang saat .htaccess ditimpa oleh deploy. Jangan diubah manual.
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
